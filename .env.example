# Local development placeholders only. Copy to .env, replace passwords, never commit .env.
COMPOSE_PROJECT_NAME=knowledgeops
MYSQL_ROOT_PASSWORD=replace-local-root-password
MYSQL_DATABASE=knowledgeops
MYSQL_USER=knowledgeops
MYSQL_PASSWORD=replace-local-app-password
REDIS_PASSWORD=replace-local-redis-password
QDRANT_API_KEY=replace-local-vector-secret
LLM_MODE=fake
EMBEDDING_MODE=fake
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=
JAVA_TO_AI_TOKEN=replace-local-java-to-ai-token
AI_TO_JAVA_TOKEN=replace-local-ai-to-java-token
JWT_SIGNING_SECRET=replace-with-strong-generated-secret-at-least-32-bytes
BOOTSTRAP_ADMIN_ENABLED=true
BOOTSTRAP_ADMIN_EMAIL=admin@example.local
BOOTSTRAP_ADMIN_PASSWORD=replace-with-demo-password-at-least-12-chars
BOOTSTRAP_ADMIN_DISPLAY_NAME=Local Administrator
ALLOWED_ORIGIN=http://localhost:5173
JAVA_PORT=8080
KNOWLEDGE_STORAGE_PATH=/app/data/uploads
FRONTEND_PORT=5173
# App images exist only after implementation/build phases.
FRONTEND_IMAGE=knowledgeops/frontend:dev
JAVA_IMAGE=knowledgeops/java-backend:dev
AI_IMAGE=knowledgeops/ai-service:dev
