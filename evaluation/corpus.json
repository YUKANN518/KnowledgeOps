      "blocks": [
        {
          "anchor": "vpn-setup",
          "text": "使用公司 VPN 客户端，服务器地址为 vpn.example.invalid，登录使用企业账号和动态验证码。"
        },
        {
          "anchor": "vpn-error",
          "text": "VPN 错误 E101 表示验证码已过期，请获取新验证码后重试；连续三次失败请提交 IT 工单。"
        },
        {
          "anchor": "vpn-device",
          "text": "公司 VPN 仅允许受管设备连接；不允许关闭终端防护软件。"
        }
      ]
    },
    {
      "sourceId": "password-v1",
      "knowledgeBase": "it",
      "knowledgeBaseId": "639d3047-e239-5487-87d9-d7f781aa7034",
