              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Context": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "conversationId": {
            "type": "string",
            "format": "uuid"
          },
          "turnId": {
            "type": "string",
            "format": "uuid"
          },
          "securityEpoch": {
            "type": "integer",
            "minimum": 0
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          },
          "allowedKnowledgeBaseIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 100
          },
          "allowedVersions": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "versionId": {
                  "type": "string",
                  "format": "uuid"
                },
                "indexGeneration": {
                  "type": "string",
                  "format": "uuid"
                }
              },
              "required": [
                "versionId",
                "indexGeneration"
              ]
            },
            "maxItems": 1000
          },
          "allowedTools": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "searchKnowledge",
                "getTicket",
                "listTickets",
                "createTicketDraft",
                "assignTicketDraft",
                "updateTicketStatusDraft",
                "addTicketCommentDraft"
              ]
            },
            "maxItems": 7
          }
        },
        "required": [
          "contextId",
          "conversationId",
          "turnId",
          "securityEpoch",
          "expiresAt",
          "allowedKnowledgeBaseIds",
          "allowedVersions",
          "allowedTools"
        ]
      },
      "DraftResult": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "draftId": {
            "type": "string",
            "format": "uuid"
          },
          "status": {
            "const": "PENDING"
          },
          "payloadHash": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "expiresAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "draftId",
          "status",
          "payloadHash",
          "expiresAt"
        ]
      },
      "Error": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80
          },
          "message": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "field": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 100
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 300
                }
              },
              "required": [
                "field",
                "reason"
              ]
            },
            "maxItems": 30
          },
          "requestId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "code",
          "message",
          "details",
          "requestId",
          "timestamp"
        ]
      },
      "Evidence": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "chunkId": {
            "type": "string",
            "format": "uuid"
          },
          "versionId": {
            "type": "string",
            "format": "uuid"
          },
          "indexGeneration": {
            "type": "string",
            "format": "uuid"
          },
          "documentId": {
            "type": "string",
            "format": "uuid"
          },
          "knowledgeBaseId": {
            "type": "string",
            "format": "uuid"
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "textSha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "pageStart": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "pageEnd": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "headingPath": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1,
                "maxLength": 1000
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "chunkId",
          "versionId",
          "indexGeneration",
          "documentId",
          "knowledgeBaseId",
          "text",
          "textSha256",
          "title",
          "pageStart",
          "pageEnd",
          "headingPath"
        ]
      },
      "EvidenceRequest": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "securityEpoch": {
            "type": "integer",
            "minimum": 0
          },
          "chunkIds": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "maxItems": 8
          }
        },
        "required": [
          "contextId",
          "securityEpoch",
          "chunkIds"
        ]
      },
      "EvidenceResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "securityEpoch": {
            "type": "integer",
            "minimum": 0
          },
          "evidence": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Evidence"
            },
            "maxItems": 8
          }
        },
        "required": [
          "securityEpoch",
          "evidence"
        ]
      },
      "InternalDraft": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "toolCallId": {
            "type": "string",
            "format": "uuid"
          },
          "call": {
            "$ref": "#/components/schemas/WriteToolCall"
          }
        },
        "required": [
          "contextId",
          "toolCallId",
          "call"
        ]
      },
      "InternalRead": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "contextId": {
            "type": "string",
            "format": "uuid"
          },
          "toolCallId": {
            "type": "string",
            "format": "uuid"
          },
          "call": {
            "$ref": "#/components/schemas/ReadToolCall"
          }
        },
        "required": [
          "contextId",
          "toolCallId",
          "call"
        ]
      },
      "ReadResult": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/Ticket"
          },
          {
            "$ref": "#/components/schemas/TicketPage"
          }
        ]
      },
      "ReadToolCall": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "const": "getTicket"
              },
              "arguments": {
                "$ref": "#/components/schemas/getTicket"
              }
            },
            "required": [
              "name",
              "arguments"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "const": "listTickets"
              },
              "arguments": {
                "$ref": "#/components/schemas/listTickets"
              }
            },
            "required": [
              "name",
              "arguments"
            ]
          }
        ]
      },
      "Ticket": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "ticketNumber": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 10000
          },
          "category": {
            "type": "string",
            "enum": [
              "IT",
              "HR",
              "FACILITIES",
              "OTHER"
            ]
          },
          "priority": {
            "type": "string",
            "enum": [
              "LOW",
              "NORMAL",
              "HIGH",
              "URGENT"
            ]
          },
          "requesterId": {
            "type": "string",
            "format": "uuid"
          },
          "departmentId": {
            "type": "string",
            "format": "uuid"
          },
          "assigneeId": {
            "anyOf": [
              {
                "type": "string",
                "format": "uuid"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "type": "string",
            "enum": [
              "OPEN",
              "IN_PROGRESS",
              "WAITING_USER",
              "RESOLVED",
              "CLOSED",
              "CANCELLED"
            ]
          },
          "version": {
            "type": "integer",
            "minimum": 0
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "updatedAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "ticketNumber",
          "title",
          "description",
          "category",
          "priority",
          "requesterId",
          "departmentId",
          "assigneeId",
          "status",
          "version",
          "createdAt",
          "updatedAt"
        ]
      },
      "TicketPage": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/Ticket"
            },
            "maxItems": 100
          },
          "page": {
            "type": "integer",
            "minimum": 0
          },
          "size": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "total": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "items",
          "page",
          "size",
          "total"
